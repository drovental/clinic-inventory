rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Clinic staff: signed in with email/password (the clinic app)
    function isStaff() {
      return request.auth != null && request.auth.token.email != null;
    }
    // Patient portal: signed in with phone, linked to one patient record
    function isPatient() {
      return request.auth != null && request.auth.token.phone_number != null
        && exists(/databases/$(database)/documents/portalUsers/$(request.auth.uid));
    }
    function myPatientId() {
      return get(/databases/$(database)/documents/portalUsers/$(request.auth.uid)).data.patientId;
    }

    match /inventory/{itemId}            { allow read, write: if isStaff(); }
    match /orders/{orderId}              { allow read, write: if isStaff(); }
    match /equipment/{equipmentId}       { allow read, write: if isStaff(); }
    match /treatmentCombos/{comboId}     { allow read, write: if isStaff(); }
    match /treatmentPlans/{planId}       { allow read, write: if isStaff(); }
    match /curatedMenus/{menuId}         { allow read, write: if isStaff(); }
    match /whatsappConversations/{convId}{ allow read, write: if isStaff(); }
    match /whatsappFollowups/{followupId}{ allow read, write: if isStaff(); }
    match /therapists/{therapistId}      { allow read, write: if isStaff(); }

    match /patients/{patientId} {
      allow read, write: if isStaff();
      allow read: if isPatient() && patientId == myPatientId();
    }
    match /treatments/{treatmentId} {
      allow read, write: if isStaff();
      allow read: if isPatient() && resource.data.patientId == myPatientId();
    }
    match /loyaltyTransactions/{txId} {
      allow read, write: if isStaff();
      allow read: if isPatient() && resource.data.patientId == myPatientId();
    }
    match /patientPhotos/{photoId} {
      allow read, write: if isStaff();
      allow read: if isPatient() && resource.data.patientId == myPatientId();
    }
    match /appointmentRequests/{reqId} {
      allow read, write: if isStaff();
      allow read: if isPatient() && resource.data.patientId == myPatientId();
      allow create: if isPatient() && request.resource.data.patientId == myPatientId() && request.resource.data.status == "pending";
      allow update: if isPatient() && resource.data.patientId == myPatientId() && request.resource.data.status == "cancelled";
    }
    match /followupProtocols/{protocolId} {
      allow read, write: if isStaff();
      allow read: if isPatient();
    }
    // Written only by the linkPortalUser cloud function; a patient may read her own link
    match /portalUsers/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if false;
    }
  }
}

